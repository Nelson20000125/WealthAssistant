# ── 资料库 ──────────────────────────────────────────────
# 本地开发：指向本地 SQLite 档案（Prisma Migrate 只能对本地跑）
DATABASE_URL="file:./dev.db"
# 部署环境：改成 Turso，并填 token
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN=""

# scripts/turso-apply-migration.ts 专用。刻意跟 DATABASE_URL 分开，
# 避免不小心把 migration 套到本地或正式站
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Mastra 对话记忆库（本地留空即用 file:./mastra.db）
# MASTRA_DB_URL="libsql://your-mastra-db.turso.io"
# MASTRA_DB_AUTH_TOKEN=""

# ── 登入 ────────────────────────────────────────────────
# Auth.js session 签名密钥，用 `npx auth secret` 产生
AUTH_SECRET=""
# 初始管理员帐号，seed 会用它建立资料归属
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── 行情 ────────────────────────────────────────────────
# 选填。留空则只用 Yahoo（股价）与 Frankfurter（汇率），
# 填了才会挂上 Alpha Vantage 当最後备援
ALPHA_VANTAGE_API_KEY=""

# ── AI ──────────────────────────────────────────────────
GOOGLE_API_KEY=""
MEM0_API_KEY=""

# AI 顾问每人每日对话上限。留空 = 不限制（本地开发不该被自己挡住）。
# 公开 demo 一定要设：帐密写在 README 里，任何人都能登入来刷这把 API key
# AI_DAILY_LIMIT="30"

# 选填，Mastra 的追踪observability
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ── 市场简报（选填）─────────────────────────────────────
# 读取外部 Supabase 的 S&P 500 新闻，留空则市场简报页没有资料
AI_HUB_SUPABASE_URL=""
AI_HUB_SUPABASE_ANON_KEY=""
