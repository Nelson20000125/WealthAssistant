// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  BROKERAGE
  FUND
  BANK
  CRYPTO
}

enum AssetType {
  STOCK
  ETF
  FUND
  CRYPTO
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
  INVEST // 投资投入：钱从现金变资产，不是支出（记支出会让月度报表虚高）
  TRANSFER // 内部转帐（如转去 TNG 电子钱包）：钱还是自己的，不算支出也不算投资
}

enum TransactionSource {
  MANUAL
  STATEMENT_IMPORT
}

// 登入用户，多用户各自持有独立的资产/收支记录
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  goals         Goal[]
  snapshots     PortfolioSnapshot[]
  aiUsage       AiUsage[]
}

// AI 顾问的每日用量。公开 demo 站的帐密写在 README 里，任何人都能登入，
// 所以对话次数要有上限，否则 API key 会被刷爆、下一个访客只会看到报错。
model AiUsage {
  id     String @id @default(cuid())
  userId String
  day    String // YYYY-MM-DD，以 Asia/Kuala_Lumpur 计。存字串而非 DateTime，
  // 是因为「今天」是个日历概念，存成时间点会在时区换算时跨日。
  count Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// 一个资金来源户口：moomoo 证券户、Public Mutual 基金户、Public Bank 现金户等
model Account {
  id          String      @id @default(cuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  type        AccountType
  institution String
  currency    String // 户口原生货币，如 MYR / USD
  holdings    Holding[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 户口里的一笔持仓：股票/ETF/基金持仓，或单纯现金余额
model Holding {
  id         String    @id @default(cuid())
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  assetType  AssetType
  symbol     String? // 有报价代号的才填，如 VOO；现金/无代号基金留空
  name       String
  quantity   Float // 股数/份额。现金类固定为 1，金额放 costBasis（2026-07-29 统一约定）
  costBasis  Float // 每单位成本。现金类＝该币种余额本身
  currency   String // 这笔持仓的计价货币
  lastPrice  Float? // 快取的最新报价（每单位），现金类等于 costBasis
  priceAsOf  DateTime?

  // ---- 现金持仓专用：余额由流水推导，不可手改（决策 2026-07-29）----
  // 期初余额挂在持仓、不挂在户口，是因为多币种户口（如 Wise）同一个 Account
  // 底下会有多笔 CASH holding，每个币种一笔，各自有各自的期初与流水。
  openingBalance     Float? // 期初余额
  openingBalanceDate DateTime? // 期初日；只有此日之后的流水才计入推导

  investTransactions      Transaction[] @relation("InvestTarget") // 买入这笔持仓的投资记录
  cashTransactions        Transaction[] @relation("InvestCash") // 动到这笔现金持仓的交易
  counterCashTransactions Transaction[] @relation("TransferCounterCash") // 转帐/换汇的对手侧
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// 行情报价快取，减少打第三方行情 API 的次数（Yahoo 无日额度但仍会限流）
model PriceCache {
  id        String   @id @default(cuid())
  symbol    String   @unique
  price     Float
  currency  String
  source    String // ALPHA_VANTAGE / COINGECKO
  fetchedAt DateTime @default(now())
}

// 汇率快取，如 USD->MYR
model FxRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  rate      Float
  fetchedAt DateTime @default(now())

  @@unique([base, quote])
}

// 消费/收入/投资分类。同名分类可在不同 type 下并存（如「其他」）
model Category {
  id           String          @id @default(cuid())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  type         TransactionType @default(EXPENSE)
  rules        CategoryRule[]
  transactions Transaction[]

  @@unique([userId, name, type])
}

// 关键字比对规则：对帐单上的描述文字命中关键字，就自动归类到对应 Category
model CategoryRule {
  id         String   @id @default(cuid())
  keyword    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
}

// 一笔收入/支出/投资纪录，手动记的或从对帐单汇入的都存这里
model Transaction {
  id         String            @id @default(cuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  date       DateTime
  amount     Float
  currency   String
  type       TransactionType
  description String
  category   Category?         @relation(fields: [categoryId], references: [id])
  categoryId String?
  source     TransactionSource
  importBatch   ImportBatch?   @relation(fields: [importBatchId], references: [id])
  importBatchId String?

  // ---- INVEST 专用（方案 B 联动，见 bookkeeping-design.md）----
  holding       Holding? @relation("InvestTarget", fields: [holdingId], references: [id])
  holdingId     String? // 买入的目标持仓
  units         Float? // 买入份额 = amount / unitPrice
  unitPrice     Float? // 买入单价（目标持仓计价货币）

  // ---- 现金联动（2026-07-29 起适用于所有 type，不再只是 INVEST）----
  // 指向「这笔钱动的是哪个现金池」。指到 Holding 而不是 Account，是因为多币种
  // 户口一个 Account 底下有多个币种余额，只指户口无法确定动的是哪一个。
  cashHolding   Holding? @relation("InvestCash", fields: [cashHoldingId], references: [id])
  cashHoldingId String? // 扣款/入帐的现金持仓，空 = 不影响任何现金余额

  // ---- TRANSFER 对手侧 ----
  // Wise 内部换汇（AUD 池 -> MYR 池）也算 TRANSFER：同一个 Account、不同币种、
  // 两边金额不相等，所以对手侧金额必须独立存，不能沿用 amount。
  counterCashHolding   Holding? @relation("TransferCounterCash", fields: [counterCashHoldingId], references: [id])
  counterCashHoldingId String? // 转入的现金持仓
  counterAmount        Float? // 转入侧金额；同币种转帐＝amount，换汇则不等

  createdAt  DateTime          @default(now())
}

// 一次对帐单汇入批次，方便追溯/整批撤销
model ImportBatch {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  fileName     String
  importedAt   DateTime      @default(now())
  transactions Transaction[]
}

// 财务目标
model Goal {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  targetAmount Float
  currency     String
  targetDate   DateTime
  notes        String?
  createdAt    DateTime @default(now())
}

// 每日净值快照：首页净值折线图（Ghostfolio 式 hero）的数据来源。
// 一天一条（date 按吉隆坡时区取日历日，存成该日 UTC 零点），
// 同一天多次刷新行情只 upsert 覆盖，不会重复。
model PortfolioSnapshot {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  date        DateTime
  netWorthMYR Float // 总净资产
  investedMYR Float // 非现金投资部位现值
  cashMYR     Float // 现金部位
  costMYR     Float // 总投入成本，算区间收益率用
  byAssetType String // JSON 序列化的 [{assetType, valueMYR}]，SQLite 没有 JSON 型别
  createdAt   DateTime @default(now())

  @@unique([userId, date])
}
